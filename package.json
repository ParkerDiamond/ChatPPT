{
  "name": "chatppt",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for programmatic PowerPoint creation and editing",
  "mcpName": "io.github.parker/chatppt",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/parker/ChatPPT.git"
  },
  "bin": {
    "chatppt": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "powerpoint",
    "pptx",
    "mcp-server",
    "vscode"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@office-kit/pptx": "^0.12.0",
    "typescript": "^5.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0"
  }
}