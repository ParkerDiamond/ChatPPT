{
  "name": "@jparkerdiamond/chatppt",
  "version": "0.1.4",
  "description": "Model Context Protocol (MCP) server for programmatic PowerPoint creation and editing",
  "publisher": "JParkerDiamond",
  "author": "J. Parker Diamond",
  "mcpName": "io.github.ParkerDiamond/chatppt",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParkerDiamond/ChatPPT.git"
  },
  "bin": {
    "chatppt": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "powerpoint",
    "pptx",
    "mcp-server",
    "vscode"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@office-kit/pptx": "^0.13.0",
    "@office-kit/pptx-preview": "^0.9.3",
    "typescript": "^5.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "vitest": "^5.0.1"
  }
}
